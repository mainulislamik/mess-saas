# Mess Management SaaS — Bangladesh Environment Variables

# App
APP_NAME="MessManager BD"
APP_ENV="development"
SECRET_KEY="supersecret_jwt_change_in_production_key_bachelor_mess"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="1440"

# Database (PostgreSQL)
POSTGRES_SERVER="db"
POSTGRES_PORT="5432"
POSTGRES_DB="messdb"
POSTGRES_USER="mess"
POSTGRES_PASSWORD="messpassword123"
DATABASE_URL="postgresql+asyncpg://mess:messpassword123@db:5432/messdb"

# Redis
REDIS_URL="redis://redis:6379/0"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:8000"]

# Frontend Public URLs
NEXT_PUBLIC_API_URL="http://localhost:8000/api/v1"
